# ฐานข้อมูลของระบบรูป — แยกจาก runludtong
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/runphoto"

# ล็อกอินแอดมินของระบบรูป (แยกจากเว็บสมัคร)
# SESSION_SECRET: สุ่มยาว ≥ 32 ตัว เช่น `openssl rand -base64 48`
SESSION_SECRET=""
# บัญชีแอดมิน — ตั้งด้วย `npm run admin:password` (รหัสเก็บเป็น hash ไม่ใช่รหัสจริง)
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""

# Google Drive (service account) — วาง JSON ทั้งก้อน หรือ path ไปยังไฟล์ JSON
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Azure Blob Storage — เก็บรูปย่อ/รูปพรีวิว
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="photos"
BLOB_PUBLIC_BASE_URL=""

# Azure AI Vision (อ่านเลข BIB) — ใช้ endpoint/key ของ Azure AI Services แบบ S0 ได้
AZURE_VISION_ENDPOINT=""
AZURE_VISION_KEY=""

# ค้นด้วยเบอร์โทร — API ของเว็บสมัครที่แปลงเบอร์เป็น BIB (เว้นว่าง = ปิดการค้นด้วยเบอร์)
RUNLUDTONG_LOOKUP_URL=""
RUNLUDTONG_LOOKUP_SECRET=""

# เว็บหลักที่ลิงก์ "← runludtong.com" ใน navbar ชี้ไป (เว้นว่าง = https://runludtong.com)
MAIN_SITE_URL=""

# ข้อความลายน้ำบนรูปพรีวิว
WATERMARK_TEXT="runludtong.com"

# จำนวนรูปที่ประมวลผลพร้อมกันตอนซิงก์ (S0 = 10, F0 ควร 2–4)
SYNC_CONCURRENCY="10"
