generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ระบบนี้ไม่มีตาราง User — ผู้ใช้/สิทธิ์ ADMIN มาจาก session ของเว็บสมัคร (runludtong) ที่ใช้ NEXTAUTH_SECRET ร่วมกัน

enum PhotoStatus {
  PENDING    // เจอใน Drive แล้ว ยังไม่ประมวลผล
  PROCESSED  // ย่อรูป + ลายน้ำ + อ่าน BIB + เก็บใบหน้าครบแล้ว
  FAILED     // ประมวลผลไม่ผ่าน ดู error — รอบซิงก์ถัดไปจะลองใหม่
}

model Event {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  eventDate     DateTime?
  // ผู้จัดงาน — ไม่ผูกกับงานวิ่งของ runludtong เพื่อรองรับงานของผู้จัดอื่นด้วย
  organizer     String?
  // โฟลเดอร์ Google Drive ที่ช่างภาพอัปโหลดรูป (ไล่โฟลเดอร์ย่อยทั้งหมด) — ต้องแชร์ให้ service account แบบ Viewer
  driveFolderId String
  isPublished   Boolean  @default(false)

  // ค้นด้วยใบหน้า — ข้อมูลใบหน้าเป็นข้อมูลชีวภาพตาม PDPA ต้องลบทิ้งตามกำหนด (purgeFacesAt)
  faceSearchEnabled Boolean   @default(true)
  purgeFacesAt      DateTime?

  // อ่านเลข BIB ด้วย OCR — regex ของรูปแบบ BIB งานนี้ (null = ใช้ค่าเริ่มต้นใน lib/bib.ts)
  bibOcrEnabled Boolean @default(true)
  bibPattern    String?

  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  photos Photo[]
}

model Photo {
  id           String      @id @default(cuid())
  eventId      String
  // ต้นฉบับอยู่ที่ Drive — ดาวน์โหลดรูปเต็มผ่านเซิร์ฟเวอร์ (ไม่ต้องเปิดแชร์สาธารณะ)
  driveFileId  String
  filename     String
  // ชื่อโฟลเดอร์ย่อยใน Drive (มักเป็นชื่อช่างภาพหรือจุดถ่าย)
  folderName   String?
  takenAt      DateTime?
  width        Int?
  height       Int?
  // key ใน Azure Blob — null จนกว่าจะประมวลผลเสร็จ
  thumbKey     String?
  previewKey   String?

  status       PhotoStatus @default(PENDING)
  error        String?     @db.Text
  attempts     Int         @default(0)
  processedAt  DateTime?
  // เก็บใบหน้าของรูปนี้แล้ว (อาจได้ 0 หน้า) — null = ยังไม่ได้ทำ ซิงก์รอบถัดไปจะทำให้
  facesIndexedAt DateTime?
  createdAt    DateTime    @default(now())

  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  faces PhotoFace[]
  bibs  PhotoBib[]

  @@unique([eventId, driveFileId])
  @@index([eventId, status])
  @@index([eventId, takenAt])
}

// หนึ่งแถว = หนึ่งหน้าในรูป — เวกเตอร์จาก lib/face.ts (เป็นข้อมูลชีวภาพ ลบได้ด้วย purgeFaces)
model PhotoFace {
  id        String @id @default(cuid())
  photoId   String
  // SFace 128 มิติ float32 (L2-normalized) = 512 ไบต์
  embedding Bytes  @db.Blob
  score     Float
  // กรอบหน้าเป็นสัดส่วน 0–1 ของรูป (left/top/width/height) — เผื่อไฮไลต์หน้าในรูป
  box       Json

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([photoId])
}

// เลข BIB ที่ OCR อ่านได้จากรูป — เก็บแบบ normalize (ตัวพิมพ์ใหญ่ ไม่มีขีด/ช่องว่าง) ดู lib/bib.ts
model PhotoBib {
  id      String @id @default(cuid())
  photoId String
  bib     String

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, bib])
  @@index([bib])
}
